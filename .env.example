# Copy to .env.local.local for local testing or .env.staging.local for staging.
# Process environment overrides .env.<environment>.local, which overrides .env.
# Example hosts deliberately do not resolve; update config/environments/staging.json first.
# Credentials are referenced by name in config and are never committed.

# BASE_URL=https://api.staging.example.invalid
# API_TOKEN=replace-with-a-short-lived-test-token
# API_KEY=replace-with-a-test-api-key
# API_USERNAME=performance-test-user
# API_PASSWORD=replace-with-a-test-password
