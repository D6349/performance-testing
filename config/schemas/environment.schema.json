{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "API performance environment",
  "additionalProperties": false,
  "required": [
    "name",
    "baseUrl",
    "allowedHosts",
    "allowHttp",
    "production"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
    },
    "baseUrl": {
      "type": "string",
      "format": "uri",
      "description": "Absolute origin; HTTPS required unless local allowHttp is true. May contain a path prefix."
    },
    "allowedHosts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Exact allowed hostnames without scheme, path, or wildcard."
    },
    "allowHttp": {
      "type": "boolean"
    },
    "production": {
      "type": "boolean"
    },
    "headers": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "auth": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "none"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "tokenEnv"
          ],
          "properties": {
            "type": {
              "const": "bearer"
            },
            "tokenEnv": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "keyEnv"
          ],
          "properties": {
            "type": {
              "const": "api-key"
            },
            "header": {
              "type": "string",
              "minLength": 1
            },
            "keyEnv": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "usernameEnv",
            "passwordEnv"
          ],
          "properties": {
            "type": {
              "const": "basic"
            },
            "usernameEnv": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "passwordEnv": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            }
          }
        }
      ]
    },
    "timeout": {
      "type": "string",
      "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h))+$"
    },
    "variables": {
      "type": "object"
    }
  }
}
