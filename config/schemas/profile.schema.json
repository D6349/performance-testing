{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "k6 workload profile",
  "additionalProperties": false,
  "required": [
    "name",
    "scenario",
    "thresholds"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$"
    },
    "scenario": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "executor",
            "vus",
            "iterations",
            "maxDuration"
          ],
          "properties": {
            "executor": {
              "const": "shared-iterations"
            },
            "gracefulStop": {
              "type": "string",
              "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h))+$"
            },
            "vus": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "iterations": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            },
            "maxDuration": {
              "type": "string",
              "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h))+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "executor",
            "vus",
            "duration"
          ],
          "properties": {
            "executor": {
              "const": "constant-vus"
            },
            "gracefulStop": {
              "type": "string",
              "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h))+$"
            },
            "vus": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "duration": {
              "type": "string",
              "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h))+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "executor",
            "stages"
          ],
          "properties": {
            "executor": {
              "const": "ramping-vus"
            },
            "gracefulStop": {
              "type": "string",
              "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h))+$"
            },
            "startVUs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "stages": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "duration",
                  "target"
                ],
                "properties": {
                  "duration": {
                    "type": "string",
                    "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h))+$"
                  },
                  "target": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000
                  }
                }
              }
            },
            "gracefulRampDown": {
              "type": "string",
              "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h))+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "executor",
            "rate",
            "timeUnit",
            "duration",
            "preAllocatedVUs",
            "maxVUs"
          ],
          "properties": {
            "executor": {
              "const": "constant-arrival-rate"
            },
            "gracefulStop": {
              "type": "string",
              "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h))+$"
            },
            "rate": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000000
            },
            "timeUnit": {
              "type": "string",
              "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h))+$"
            },
            "duration": {
              "type": "string",
              "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h))+$"
            },
            "preAllocatedVUs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "maxVUs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "executor",
            "startRate",
            "timeUnit",
            "stages",
            "preAllocatedVUs",
            "maxVUs"
          ],
          "properties": {
            "executor": {
              "const": "ramping-arrival-rate"
            },
            "gracefulStop": {
              "type": "string",
              "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h))+$"
            },
            "startRate": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "timeUnit": {
              "type": "string",
              "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h))+$"
            },
            "stages": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "duration",
                  "target"
                ],
                "properties": {
                  "duration": {
                    "type": "string",
                    "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h))+$"
                  },
                  "target": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000000
                  }
                }
              }
            },
            "preAllocatedVUs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "maxVUs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          }
        }
      ]
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "http_req_duration",
        "http_req_failed",
        "checks",
        "workflow_failed",
        "workflow_requests"
      ],
      "properties": {
        "http_req_duration": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "threshold",
                  "abortOnFail"
                ],
                "properties": {
                  "threshold": {
                    "type": "string",
                    "minLength": 1
                  },
                  "abortOnFail": {
                    "type": "boolean"
                  },
                  "delayAbortEval": {
                    "type": "string",
                    "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h))+$"
                  }
                }
              }
            ]
          }
        },
        "http_req_failed": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "threshold",
                  "abortOnFail"
                ],
                "properties": {
                  "threshold": {
                    "type": "string",
                    "minLength": 1
                  },
                  "abortOnFail": {
                    "type": "boolean"
                  },
                  "delayAbortEval": {
                    "type": "string",
                    "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h))+$"
                  }
                }
              }
            ]
          }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "threshold",
                  "abortOnFail"
                ],
                "properties": {
                  "threshold": {
                    "type": "string",
                    "minLength": 1
                  },
                  "abortOnFail": {
                    "type": "boolean"
                  },
                  "delayAbortEval": {
                    "type": "string",
                    "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h))+$"
                  }
                }
              }
            ]
          }
        },
        "workflow_failed": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "threshold",
                  "abortOnFail"
                ],
                "properties": {
                  "threshold": {
                    "type": "string",
                    "minLength": 1
                  },
                  "abortOnFail": {
                    "type": "boolean"
                  },
                  "delayAbortEval": {
                    "type": "string",
                    "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h))+$"
                  }
                }
              }
            ]
          }
        },
        "workflow_requests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "threshold",
                  "abortOnFail"
                ],
                "properties": {
                  "threshold": {
                    "type": "string",
                    "minLength": 1
                  },
                  "abortOnFail": {
                    "type": "boolean"
                  },
                  "delayAbortEval": {
                    "type": "string",
                    "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h))+$"
                  }
                }
              }
            ]
          }
        },
        "dropped_iterations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "threshold",
                  "abortOnFail"
                ],
                "properties": {
                  "threshold": {
                    "type": "string",
                    "minLength": 1
                  },
                  "abortOnFail": {
                    "type": "boolean"
                  },
                  "delayAbortEval": {
                    "type": "string",
                    "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?(?:ms|s|m|h))+$"
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scenario": {
            "properties": {
              "executor": {
                "enum": [
                  "constant-arrival-rate",
                  "ramping-arrival-rate"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "thresholds": {
            "required": [
              "dropped_iterations"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "thresholds": {
            "not": {
              "required": [
                "dropped_iterations"
              ]
            }
          }
        }
      }
    }
  ]
}
